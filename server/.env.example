# ---- RideLedger API ----
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/rideledger

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Allowed frontend origin(s), comma-separated
CLIENT_URL=http://localhost:5173

# Receipt storage provider: "local" (default). Add new providers in services/storage/
UPLOAD_STORAGE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Business day timezone (IANA). Liberia = Africa/Monrovia
BUSINESS_TZ=Africa/Monrovia

# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=20

# Password used by the seed script for demo accounts
SEED_DEMO_PASSWORD=RideLedger@2026
